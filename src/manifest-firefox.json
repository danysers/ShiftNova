{
    "browser_specific_settings": {
        "gecko": {
            "id": "shiftnova@danysers.github.io",
            "strict_min_version": "109.0",
            "update_url": "https://danysers.github.io/ShiftNova/updates.json"
        },
        "gecko_android": {}
    },
    "background": {
        "page": "background/index.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "inject/fallback.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true,
            "world": "MAIN"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "inject/shiftnova.js",
                "inject/index.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true,
            "world": "ISOLATED"
        }
    ],
    "permissions": [
        "alarms",
        "contextMenus",
        "storage",
        "tabs",
        "theme",
        "<all_urls>"
    ],
    "optional_permissions": []
}
